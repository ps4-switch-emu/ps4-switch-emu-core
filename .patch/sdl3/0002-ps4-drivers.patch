+#include "../../SDL_internal.h"
+
+#ifdef __INTELLISENSE__
+#define SDL_JOYSTICK_PS4 1
+#endif
+
+
+#if SDL_JOYSTICK_PS4
+
+/* DualShock 4 through libScePad (Eden for PS4: rewritten - sticks and triggers are axes, the
+   d-pad is a hat, and the driver supplies its own gamepad mapping under its own GUID). */
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+#include <orbis/libkernel.h>
+#include <sys/stat.h>
+
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+
+#define MAX_PADS 4
+
+/* Joystick buttons, in this order: */
+static const uint32_t button_map[] = {
+	ORBIS_PAD_BUTTON_CROSS,     /* 0: a (south) */
+	ORBIS_PAD_BUTTON_CIRCLE,    /* 1: b (east) */
+	ORBIS_PAD_BUTTON_SQUARE,    /* 2: x (west) */
+	ORBIS_PAD_BUTTON_TRIANGLE,  /* 3: y (north) */
+	ORBIS_PAD_BUTTON_L1,        /* 4: left shoulder */
+	ORBIS_PAD_BUTTON_R1,        /* 5: right shoulder */
+	ORBIS_PAD_BUTTON_TOUCH_PAD, /* 6: back */
+	ORBIS_PAD_BUTTON_OPTIONS,   /* 7: start */
+	ORBIS_PAD_BUTTON_L3,        /* 8: left stick */
+	ORBIS_PAD_BUTTON_R3,        /* 9: right stick */
+};
+/* Axes: 0 left x, 1 left y, 2 right x, 3 right y, 4 L2, 5 R2. Hat 0: d-pad. */
+#define NUM_AXES 6
+
+typedef struct PS4Pad
+{
+	OrbisUserServiceUserId user;
+	int32_t handle;
+	bool announced;
+	uint32_t old_buttons;
+	bool sensors;
+	uint8_t old_fingers[2];
+} PS4Pad;
+
+/* DualShock 4 touchpad resolution (scePad reports raw coordinates). */
+#define TOUCH_W 1920.0f
+#define TOUCH_H 943.0f
+
+static PS4Pad pads[MAX_PADS];
+static int num_pads = 0;
+
+static void PS4_JoystickDetect(void)
+{
+	OrbisUserServiceLoginUserIdList users;
+	if (sceUserServiceGetLoginUserIdList(&users) != ORBIS_OK) {
+		return;
+	}
+	for (int i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS && num_pads < MAX_PADS; i++) {
+		const OrbisUserServiceUserId user = users.userId[i];
+		if (user == ORBIS_USER_SERVICE_USER_ID_INVALID) {
+			continue;
+		}
+		bool known = false;
+		for (int p = 0; p < num_pads; p++) {
+			known |= pads[p].user == user;
+		}
+		if (known) {
+			continue;
+		}
+		int32_t handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+		if (handle == ORBIS_PAD_ERROR_ALREADY_OPENED) {
+			handle = scePadGetHandle(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0);
+		}
+		if (handle <= 0) {
+			continue;
+		}
+		pads[num_pads].user = user;
+		pads[num_pads].handle = handle;
+		pads[num_pads].announced = false;
+		pads[num_pads].old_buttons = 0;
+		num_pads++;
+	}
+	/* Joysticks only reach apps (Eden waits for SDL_EVENT_JOYSTICK_ADDED) once announced. */
+	for (int p = 0; p < num_pads; p++) {
+		if (!pads[p].announced) {
+			pads[p].announced = true;
+			SDL_PrivateJoystickAdded((SDL_JoystickID)pads[p].handle);
+		}
+	}
+}
+
+static bool PS4_JoystickInit(void)
+{
+	SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+	const int32_t res = sceUserServiceInitialize(NULL);
+	if (res != ORBIS_OK && res != ORBIS_USER_SERVICE_ERROR_ALREADY_INITIALIZED) {
+		return SDL_SetError("sceUserServiceInitialize() failed");
+	}
+	if (scePadInit() != ORBIS_OK) {
+		return SDL_SetError("scePadInit() failed");
+	}
+	PS4_JoystickDetect();
+	return true;
+}
+
+static int PS4_JoystickGetCount(void)
+{
+	return num_pads;
+}
+
+static bool PS4_JoystickIsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+	return false;
+}
+
+static const char *PS4_JoystickGetDeviceName(int device_index)
+{
+	return "PS4 DualShock 4";
+}
+
+static const char *PS4_JoystickGetDevicePath(int device_index)
+{
+	return NULL;
+}
+
+static int PS4_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+	return -1;
+}
+
+static int PS4_JoystickGetDevicePlayerIndex(int device_index)
+{
+	return device_index;
+}
+
+static void PS4_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+}
+
+static SDL_GUID PS4_JoystickGetDeviceGUID(int device_index)
+{
+	/* No vendor/product: the GUID carries the name, so no gamecontrollerdb entry matches and
+	   SDL uses PS4_GetGamepadMapping below. */
+	return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_UNKNOWN, 0, 0, 0, NULL, PS4_JoystickGetDeviceName(device_index), 'p', 0);
+}
+
+static SDL_JoystickID PS4_JoystickGetDeviceInstanceID(int device_index)
+{
+	return (device_index >= 0 && device_index < num_pads) ? (SDL_JoystickID)pads[device_index].handle : 0;
+}
+
+static PS4Pad *PS4_PadForJoystick(SDL_Joystick *joystick)
+{
+	for (int p = 0; p < num_pads; p++) {
+		if ((SDL_JoystickID)pads[p].handle == joystick->instance_id) {
+			return &pads[p];
+		}
+	}
+	return NULL;
+}
+
+static bool PS4_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+	if (device_index < 0 || device_index >= num_pads) {
+		return SDL_SetError("No such PS4 pad");
+	}
+	joystick->nbuttons = SDL_arraysize(button_map);
+	joystick->naxes = NUM_AXES;
+	joystick->nhats = 1;
+	pads[device_index].old_buttons = 0;
+	pads[device_index].sensors = false;
+	SDL_PrivateJoystickAddTouchpad(joystick, 2);
+	SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_GYRO, 250.0f);
+	SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_ACCEL, 250.0f);
+	SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RUMBLE_BOOLEAN, true);
+	SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RGB_LED_BOOLEAN, true);
+	return true;
+}
+
+static bool PS4_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+	PS4Pad *pad = PS4_PadForJoystick(joystick);
+	if (!pad) {
+		return SDL_Unsupported();
+	}
+	OrbisPadVibeParam param;
+	SDL_zero(param);
+	param.lgMotor = (uint8_t)(low_frequency_rumble >> 8);
+	param.smMotor = (uint8_t)(high_frequency_rumble >> 8);
+	return scePadSetVibration(pad->handle, &param) == ORBIS_OK ? true : SDL_SetError("scePadSetVibration failed");
+}
+
+static bool PS4_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left, Uint16 right)
+{
+	return SDL_Unsupported();
+}
+
+static bool PS4_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+	PS4Pad *pad = PS4_PadForJoystick(joystick);
+	if (!pad) {
+		return SDL_Unsupported();
+	}
+	OrbisPadColor color = {red, green, blue, 0};
+	return scePadSetLightBar(pad->handle, &color) == ORBIS_OK ? true : SDL_SetError("scePadSetLightBar failed");
+}
+
+static bool PS4_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+	return SDL_Unsupported();
+}
+
+static bool PS4_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
+{
+	PS4Pad *pad = PS4_PadForJoystick(joystick);
+	if (!pad) {
+		return SDL_Unsupported();
+	}
+	pad->sensors = enabled; /* the DS4 always reports motion; just start/stop forwarding it */
+	return true;
+}
+
+/* 0..255 stick (128 centre) to -32768..32767 */
+static Sint16 StickAxis(uint8_t v)
+{
+	return (Sint16)(((int)v - 128) * 257 + ((v >= 128) ? 127 : 0));
+}
+
+/* 0..255 trigger to the trigger axis range -32768..32767 that SDL's mappings expect */
+static Sint16 TriggerAxis(uint8_t v)
+{
+	return (Sint16)((int)v * 257 - 32768);
+}
+
+static void PS4_JoystickUpdate(SDL_Joystick *joystick)
+{
+	PS4Pad *pad = PS4_PadForJoystick(joystick);
+	if (!pad) {
+		return;
+	}
+	OrbisPadData data;
+	if (scePadReadState(pad->handle, &data) != ORBIS_OK || !data.connected) {
+		return;
+	}
+	const Uint64 timestamp = SDL_GetTicksNS();
+	const uint32_t buttons = data.buttons;
+	const uint32_t changed = pad->old_buttons ^ buttons;
+	pad->old_buttons = buttons;
+	for (Uint8 i = 0; i < SDL_arraysize(button_map); i++) {
+		if (changed & button_map[i]) {
+			SDL_SendJoystickButton(timestamp, joystick, i, (buttons & button_map[i]) != 0);
+		}
+	}
+	/* SDL drops unchanged values itself. */
+	SDL_SendJoystickAxis(timestamp, joystick, 0, StickAxis(data.leftStick.x));
+	SDL_SendJoystickAxis(timestamp, joystick, 1, StickAxis(data.leftStick.y));
+	SDL_SendJoystickAxis(timestamp, joystick, 2, StickAxis(data.rightStick.x));
+	SDL_SendJoystickAxis(timestamp, joystick, 3, StickAxis(data.rightStick.y));
+	SDL_SendJoystickAxis(timestamp, joystick, 4, TriggerAxis(data.analogButtons.l2));
+	SDL_SendJoystickAxis(timestamp, joystick, 5, TriggerAxis(data.analogButtons.r2));
+
+	Uint8 hat = SDL_HAT_CENTERED;
+	if (buttons & ORBIS_PAD_BUTTON_UP) {
+		hat |= SDL_HAT_UP;
+	}
+	if (buttons & ORBIS_PAD_BUTTON_DOWN) {
+		hat |= SDL_HAT_DOWN;
+	}
+	if (buttons & ORBIS_PAD_BUTTON_LEFT) {
+		hat |= SDL_HAT_LEFT;
+	}
+	if (buttons & ORBIS_PAD_BUTTON_RIGHT) {
+		hat |= SDL_HAT_RIGHT;
+	}
+	SDL_SendJoystickHat(timestamp, joystick, 0, hat);
+
+	/* Touchpad: up to two fingers, normalised to 0..1. */
+	for (int f = 0; f < 2; f++) {
+		const bool down = f < data.touch.fingers;
+		if (down) {
+			const OrbisPadTouch *t = &data.touch.touch[f];
+			SDL_SendJoystickTouchpad(timestamp, joystick, 0, f, true, t->x / TOUCH_W, t->y / TOUCH_H, 1.0f);
+		} else if (pad->old_fingers[f]) {
+			SDL_SendJoystickTouchpad(timestamp, joystick, 0, f, false, 0.0f, 0.0f, 0.0f);
+		}
+		pad->old_fingers[f] = down;
+	}
+
+	/* Motion: angular velocity in rad/s, acceleration in G (SDL wants m/s^2). */
+	if (pad->sensors) {
+		const float gyro[3] = {data.vel.x, data.vel.y, data.vel.z};
+		const float accel[3] = {data.acell.x * SDL_STANDARD_GRAVITY, data.acell.y * SDL_STANDARD_GRAVITY,
+		                        data.acell.z * SDL_STANDARD_GRAVITY};
+		SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_GYRO, data.timestamp, gyro, 3);
+		SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_ACCEL, data.timestamp, accel, 3);
+	}
+}
+
+static void PS4_JoystickClose(SDL_Joystick *joystick)
+{
+	/* Keep the pad open: it belongs to the user, and Detect would only reopen it. */
+}
+
+static void PS4_JoystickQuit(void)
+{
+	for (int p = 0; p < num_pads; p++) {
+		scePadClose(pads[p].handle);
+	}
+	num_pads = 0;
+}
+
+static void SetButton(SDL_InputMapping *m, Uint8 index)
+{
+	m->kind = EMappingKind_Button;
+	m->target = index;
+}
+
+static void SetAxis(SDL_InputMapping *m, Uint8 index)
+{
+	m->kind = EMappingKind_Axis;
+	m->target = index;
+}
+
+static void SetHat(SDL_InputMapping *m, Uint8 mask)
+{
+	m->kind = EMappingKind_Hat;
+	m->target = mask; /* hat 0: (index << 4) | mask */
+}
+
+static bool PS4_GetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+	/* Eden for PS4's launcher "Button layout: PlayStation": Cross acts as the Switch's A (confirm)
+	   and Circle as B, Square as X, Triangle as Y - the PlayStation habit - instead of matching
+	   the buttons' positions. SDL's south/east/west/north are what Eden maps by position. */
+	struct stat st;
+	const bool swap = stat("/data/switch-emu/cross-is-a", &st) == 0;
+	SetButton(&out->a, swap ? 1 : 0);
+	SetButton(&out->b, swap ? 0 : 1);
+	SetButton(&out->x, swap ? 3 : 2);
+	SetButton(&out->y, swap ? 2 : 3);
+	SetButton(&out->leftshoulder, 4);
+	SetButton(&out->rightshoulder, 5);
+	SetButton(&out->back, 6);
+	SetButton(&out->start, 7);
+	SetButton(&out->leftstick, 8);
+	SetButton(&out->rightstick, 9);
+	SetHat(&out->dpup, SDL_HAT_UP);
+	SetHat(&out->dpright, SDL_HAT_RIGHT);
+	SetHat(&out->dpdown, SDL_HAT_DOWN);
+	SetHat(&out->dpleft, SDL_HAT_LEFT);
+	SetAxis(&out->leftx, 0);
+	SetAxis(&out->lefty, 1);
+	SetAxis(&out->rightx, 2);
+	SetAxis(&out->righty, 3);
+	SetAxis(&out->lefttrigger, 4);
+	SetAxis(&out->righttrigger, 5);
+	return true;
+}
+
+SDL_JoystickDriver SDL_PS4_JoystickDriver =
+{
+	PS4_JoystickInit,
+	PS4_JoystickGetCount,
+	PS4_JoystickDetect,
+	PS4_JoystickIsDevicePresent,
+	PS4_JoystickGetDeviceName,
+	PS4_JoystickGetDevicePath,
+	PS4_JoystickGetDeviceSteamVirtualGamepadSlot,
+	PS4_JoystickGetDevicePlayerIndex,
+	PS4_JoystickSetDevicePlayerIndex,
+	PS4_JoystickGetDeviceGUID,
+	PS4_JoystickGetDeviceInstanceID,
+	PS4_JoystickOpen,
+	PS4_JoystickRumble,
+	PS4_JoystickRumbleTriggers,
+	PS4_JoystickSetLED,
+	PS4_JoystickSendEffect,
+	PS4_JoystickSetSensorsEnabled,
+	PS4_JoystickUpdate,
+	PS4_JoystickClose,
+	PS4_JoystickQuit,
+	PS4_GetGamepadMapping,
+};
+
+#endif /* SDL_JOYSTICK_PS4 */
